@model StjacksAssistens.Models.MecanicosReportViewModel
@{
    Layout = null;
    var listaPeriodos = ViewBag.TodosLosPeriodos as List<StjacksAssistens.Models.Periodss>;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Reporte Horas - @Model.Periodo.Description</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/spreadssheet.css" />
    <style>
        .editable-motivo {
            min-height: 25px;
            border: 1px solid transparent;
        }

            .editable-motivo:hover {
                border: 1px dashed #ccc;
                cursor: text;
            }

        .in-h, .in-m {
            border: 1px solid #ccc;
            border-radius: 4px;
            text-align: center;
        }
    </style>
</head>
<body class="p-4 bg-white">
    <div class="no-print p-3 mb-4 shadow-sm rounded border bg-light">
        <div class="row align-items-center">
            <div class="col-md-5 position-relative">
                <input type="text" id="periodSearchInput" class="form-control form-control-sm" placeholder="Buscar periodo...">
            </div>
            <div class="col-md-7 text-end">
                <button onclick="window.print()" class="btn btn-dark btn-sm"><i class="bi bi-printer"></i> Imprimir</button>
                <a href="/Absenteeism/ReporteMecanicos?periodId=@Model.Periodo.Id" class="btn btn-primary btn-sm">Ver por Días</a>
            </div>
        </div>
    </div>

    <h5 class="fw-bold text-decoration-underline mb-4 text-center">REPORTE DE DESCUENTOS POR HORA - MANTENIMIENTO</h5>

    <table class="table-excel w-100">
        <thead>
            <tr class="header-purple">
                <th>No.</th>
                <th>Código</th>
                <th>Nombre</th>
                <th>Tiempo (H:M)</th>
                <th>Descuento ($)</th>
                <th>Observaciones</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Empleados.Count; i++)
            {
                var emp = Model.Empleados[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td class="fw-bold">@emp.Codigo</td>
                    <td class="text-start ps-2">@emp.Nombre</td>
                    <td>
                        <div class="d-flex justify-content-center align-items-center">
                            <input type="number" class="in-h" value="@emp.HorasAusente" oninput="calcular(this)" onblur="saveTime(this)" data-opid="@emp.Codigo" style="width:55px">
                            <b class="mx-1">:</b>
                            <input type="number" class="in-m" value="@emp.MinutosAusente" oninput="calcular(this)" onblur="saveTime(this)" data-opid="@emp.Codigo" style="width:55px">
                        </div>
                    </td>
                    <td class="label-descuento fw-bold text-danger" style="width: 120px;">$ 0.00</td>
                    <td class="p-1">
                        <div class="editable-motivo" contenteditable="true" onblur="saveObservation(this)" data-opid="@emp.Codigo">
                            @(emp.Semanas.FirstOrDefault()?.Motivo)
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <script>
        // Importante: Cambia 'Absenteeism' si tu controlador tiene otro nombre
        const CONTROLLER = "Absenteeism";

        function calcular(el) {
            const row = el.closest('tr');
            const h = parseInt(row.querySelector('.in-h').value) || 0;
            const m = parseInt(row.querySelector('.in-m').value) || 0;
            const res = row.querySelector('.label-descuento');
            // Cálculo: (minutos totales) * tarifa por minuto
            res.innerText = "$ " + (((h * 60) + m) * 0.0275).toFixed(2);
        }

        async function saveTime(el) {
            const row = el.closest('tr');
            const data = {
                OperatorCode: el.getAttribute('data-opid').toString(),
                PeriodId: parseInt("@Model.Periodo.Id"),
                Hours: parseInt(row.querySelector('.in-h').value) || 0,
                Minutes: parseInt(row.querySelector('.in-m').value) || 0
            };

            const resp = await fetch(`/${CONTROLLER}/GuardarHorasMecanico`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if(resp.ok) console.log("Tiempo guardado");
        }

        async function saveObservation(el) {
            const data = {
                OperatorCode: el.getAttribute('data-opid').toString(),
                PeriodId: parseInt("@Model.Periodo.Id"),
                Observation: el.innerText.trim()
            };

            const resp = await fetch(`/${CONTROLLER}/GuardarObservacion`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if(resp.ok) console.log("Observación guardada");
        }

        window.onload = () => {
            document.querySelectorAll('.in-h').forEach(el => calcular(el));
        };
    </script>
</body>
</html>