@model StjacksAssistens.Models.MecanicosReportViewModel
@{
    Layout = null;
    var listaPeriodos = ViewBag.TodosLosPeriodos as List<StjacksAssistens.Models.Periodss>;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Reporte Horas - @Model.Periodo.Description</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/spreadssheet.css" />
</head>
<body class="p-4 bg-white">

    @* Buscador de Periodos (No se imprime) *@
    <div class="no-print p-3 mb-4 shadow-sm rounded border bg-light">
        <div class="row align-items-center">
            <div class="col-md-5 position-relative">
                <label class="fw-bold small text-muted"><i class="bi bi-search"></i> Cambiar Periodo:</label>
                <input type="text" id="periodSearchInput" class="form-control form-control-sm" placeholder="Buscar periodo..." autocomplete="off">
                <div id="periodSearchResults" class="search-results-container" style="display: none;">
                    @foreach (var p in listaPeriodos)
                    {
                        <div class="search-item" data-id="@p.Id" data-filter="@p.Description.ToLower() @p.StartDate.ToString("dd/MM/yyyy")">
                            <strong>@p.Description</strong><br>
                            <span class="text-muted small">@p.StartDate.ToShortDateString() - @p.EndDate.ToShortDateString()</span>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-7 text-end">
                <button onclick="window.print()" class="btn btn-dark btn-sm">
                    <i class="bi bi-printer"></i> Imprimir Reporte
                </button>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Regresar
                </a>
            </div>
        </div>
    </div>

    @* Encabezado del Reporte *@
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-bold" style="font-size: 14px;">INDUSTRIAS ST. JACK'S S.A. DE C.V.</span>
        <span class="fw-bold text-decoration-underline" style="font-size: 16px;">REPORTE DE DESCUENTOS POR HORA (MECÁNICOS)</span>
    </div>

    <table class="table-excel mb-3">
        <tr class="header-purple">
            <td style="width: 10%;">CDC</td>
            <td style="width: 40%;">Nombre del Área, Depto. o Gerencia</td>
            <td style="width: 20%;">Tipo de Planilla</td>
            <td style="width: 30%;">Período de Pago</td>
        </tr>
        <tr>
            <td>409</td>
            <td>MANTENIMIENTO (MECÁNICOS)</td>
            <td>14 Días (Catorcenal)</td>
            <td class="fw-bold">Del @Model.Periodo.StartDate.ToString("dd/MM/yyyy") al @Model.Periodo.EndDate.ToString("dd/MM/yyyy")</td>
        </tr>
    </table>

    @* Tabla Principal *@
    <table class="table-excel">
        <thead>
            <tr class="header-purple">
                <th style="width: 30px;">No.</th>
                <th style="width: 65px;">Código</th>
                <th>Nombre del Empleado</th>
                <th style="width: 110px;">Tiempo (H:M)</th>
                <th style="width: 100px;">Descuento</th>
                <th>Motivo de la Ausencia / Observaciones</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Empleados.Count; i++)
            {
                var emp = Model.Empleados[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td class="fw-bold">@emp.Codigo</td>
                    <td class="text-start ps-2">@emp.Nombre</td>
                    <td>
                        <div class="time-input-group no-print">
                            <input type="number" class="in-h" value="@emp.HorasAusente"
                                   onblur="saveTime(this)" data-opid="@emp.Codigo" placeholder="0"> :
                            <input type="number" class="in-m" value="@emp.MinutosAusente"
                                   onblur="saveTime(this)" data-opid="@emp.Codigo" placeholder="0">
                        </div>
                        <span class="only-print fw-bold">@emp.HorasAusente:@emp.MinutosAusente.ToString("D2")</span>
                    </td>
                    <td class="label-descuento" data-opid="@emp.Codigo">
                        $ 0.00
                    </td>
                    <td class="text-start p-1">
                        <div class="editable-motivo" contenteditable="true"
                             data-opid="@emp.Codigo" data-period="@Model.Periodo.Id"
                             onblur="saveObservation(this)">
                            @emp.Semanas.FirstOrDefault()?.Motivo
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* Sección de Firmas *@
    <div class="signature-section mt-5">
        <div class="signature-box">
            <div class="signature-line"></div>
            <div class="fw-bold">Elaborado por:</div>
            <div class="small">Digitador de Planilla</div>
        </div>
        <div class="signature-box">
            <div class="signature-line"></div>
            <div class="fw-bold">Revisado por:</div>
            <div class="small">Jefe de Mantenimiento</div>
        </div>
        <div class="signature-box">
            <div class="signature-line"></div>
            <div class="fw-bold">Autorizado por:</div>
            <div class="small">Recursos Humanos</div>
        </div>
    </div>

    <script>
        // --- CÁLCULO DE DESCUENTO ---
        function calcularDescuento() {
            const factorSueldoMinuto = 0.0275; // Ajustar según política de la empresa

            document.querySelectorAll('tbody tr').forEach(row => {
                const h = parseInt(row.querySelector('.in-h').value) || 0;
                const m = parseInt(row.querySelector('.in-m').value) || 0;
                const lbl = row.querySelector('.label-descuento');

                const totalMinutos = (h * 60) + m;
                const totalDsc = totalMinutos * factorSueldoMinuto;

                lbl.innerText = "$ " + totalDsc.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            });
        }

        // --- GUARDAR TIEMPO ---
        async function saveTime(el) {
            const row = el.closest('tr');
            const h = row.querySelector('.in-h').value;
            const m = row.querySelector('.in-m').value;

            // Efecto visual de guardado
            row.classList.add('saving');

            await fetch('/Ausentismo/GuardarHorasMecanico', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    OperatorCode: el.getAttribute('data-opid'),
                    PeriodId: @Model.Periodo.Id,
                    Hours: parseInt(h) || 0,
                    Minutes: parseInt(m) || 0
                })
            });

            row.classList.remove('saving');
            calcularDescuento();
        }

        // --- GUARDAR OBSERVACIÓN ---
        function saveObservation(element) {
            const text = element.innerText.trim();
            fetch('/Ausentismo/GuardarObservacion', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    OperatorCode: element.getAttribute('data-opid'),
                    PeriodId: parseInt(element.getAttribute('data-period')),
                    Observation: text
                })
            });
        }

        // --- BUSCADOR ---
        const input = document.getElementById('periodSearchInput');
        const container = document.getElementById('periodSearchResults');
        const allItems = document.querySelectorAll('.search-item');

        input.addEventListener('input', function() {
            const searchText = this.value.toLowerCase().trim();
            if (!searchText) { container.style.display = 'none'; return; }
            let found = 0;
            allItems.forEach(item => {
                if (item.getAttribute('data-filter').includes(searchText)) {
                    item.style.display = 'block'; found++;
                } else item.style.display = 'none';
            });
            container.style.display = found ? 'block' : 'none';
        });

        allItems.forEach(item => {
            item.addEventListener('click', () => {
                window.location.href = '?periodId=' + item.getAttribute('data-id');
            });
        });

        // Inicializar cálculos
        window.onload = calcularDescuento;
    </script>
</body>
</html>