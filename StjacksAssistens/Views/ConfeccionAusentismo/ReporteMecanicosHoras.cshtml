@model MecanicosReportViewModel
@{
    Layout = null;
    var listaPeriodos = ViewBag.TodosLosPeriodos as List<StjacksAssistens.ConfeccionModels.Periodss>;
    var empleadosConAusencias = Model.Empleados.Where(emp => emp.Semanas.Any(s => s.Lunes.HasValue || s.Martes.HasValue || s.Miercoles.HasValue || s.Jueves.HasValue || s.Viernes.HasValue)).ToList();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Reporte Ausentismo Horas - @Model.Periodo.Description</title>
    <link class="no-print" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/spreadssheet.css" />
</head>
<body class="p-4 bg-white">

    <div class="no-print p-3 mb-4 shadow-sm rounded border bg-light">
        <div class="row align-items-center">
            <div class="col-md-5 position-relative">
                <label class="fw-bold small text-muted"><i class="bi bi-search"></i> Digite fecha o nombre del periodo:</label>
                <input type="text" id="periodSearchInput" class="form-control form-control-sm" placeholder="Ej: 2026..." autocomplete="off">
                <div id="periodSearchResults" class="search-results-container" style="display: none;">
                    @foreach (var p in listaPeriodos)
                    {
                        <div class="search-item" data-id="@p.Id" data-filter="@p.Description.ToLower() @p.StartDate.ToString("dd/MM/yyyy")">
                            <strong>@p.Description</strong><br>
                            <span class="text-muted small">Rango: @p.StartDate.ToShortDateString() - @p.EndDate.ToShortDateString()</span>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-7 text-end">
                <button onclick="window.print()" class="btn btn-dark btn-sm">
                    <i class="bi bi-printer"></i> Imprimir Documento
                </button>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Regresar
                </a>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-bold" style="font-size: 12px; font-family: Arial;">INDUSTRIAS ST. JACK'S S.A. DE C.V.</span>
        <span class="fw-bold text-decoration-underline" style="font-size: 13px; font-family: Arial;">REPORTE DE DESCUENTOS POR HORA - MECÁNICOS</span>
    </div>

    <table class="table-excel mb-3">
        <tr class="header-purple">
            <td style="width: 10%;">CDC</td>
            <td style="width: 40%;">Nombre del Área, Depto. o Gerencia</td>
            <td style="width: 20%;">Tipo de Planilla</td>
            <td style="width: 30%;">Período de Pago</td>
        </tr>
        <tr>
            <td>409</td>
            <td>MANTENIMIENTO (MECÁNICOS)</td>
            <td>14 Días (Catorcenal)</td>
            <td class="fw-bold">Del @Model.Periodo.StartDate.ToString("dd/MM/yyyy") al @Model.Periodo.EndDate.ToString("dd/MM/yyyy")</td>
        </tr>
    </table>

    <table class="table-excel">
        <thead>
            <tr class="header-purple">
                <th rowspan="2" style="width: 35px;">NO.</th>
                <th rowspan="2" style="width: 65px;">CÓDIGO</th>
                <th rowspan="2" style="width: 30%;">NOMBRE DEL EMPLEADO</th>
                <th colspan="5">DÍAS DE LA SEMANA</th>
                <th rowspan="2" style="width: 100px;">TIEMPO (H:M)</th>
                <th rowspan="2" style="width: 90px;">DESCUENTO</th>
                <th rowspan="2">MOTIVO / OBSERVACIONES</th>
            </tr>
            <tr class="header-purple">
                <th style="width: 55px;">LUN</th>
                <th style="width: 55px;">MAR</th>
                <th style="width: 55px;">MIE</th>
                <th style="width: 55px;">JUE</th>
                <th style="width: 55px;">VIE</th>
            </tr>
        </thead>
        <tbody>
            @{
                int count = 1;
                var finSemana1 = Model.Periodo.StartDate.AddDays(6).Date;
            }
            @foreach (var emp in empleadosConAusencias)
            {
                var todosLosLunes = emp.Semanas.Where(s => s.Lunes.HasValue).Select(s => s.Lunes.Value.Date).ToList();
                var todosLosMartes = emp.Semanas.Where(s => s.Martes.HasValue).Select(s => s.Martes.Value.Date).ToList();
                var todosLosMiercoles = emp.Semanas.Where(s => s.Miercoles.HasValue).Select(s => s.Miercoles.Value.Date).ToList();
                var todosLosJueves = emp.Semanas.Where(s => s.Jueves.HasValue).Select(s => s.Jueves.Value.Date).ToList();
                var todosLosViernes = emp.Semanas.Where(s => s.Viernes.HasValue).Select(s => s.Viernes.Value.Date).ToList();

                var registroSem1 = emp.Semanas.FirstOrDefault(s => (s.Lunes.HasValue && s.Lunes.Value.Date <= finSemana1) || (s.Martes.HasValue && s.Martes.Value.Date <= finSemana1) || (s.Miercoles.HasValue && s.Miercoles.Value.Date <= finSemana1) || (s.Jueves.HasValue && s.Jueves.Value.Date <= finSemana1) || (s.Viernes.HasValue && s.Viernes.Value.Date <= finSemana1));
                var registroSem2 = emp.Semanas.FirstOrDefault(s => (s.Lunes.HasValue && s.Lunes.Value.Date > finSemana1) || (s.Martes.HasValue && s.Martes.Value.Date > finSemana1) || (s.Miercoles.HasValue && s.Miercoles.Value.Date > finSemana1) || (s.Jueves.HasValue && s.Jueves.Value.Date > finSemana1) || (s.Viernes.HasValue && s.Viernes.Value.Date > finSemana1));

                var lunSem1 = todosLosLunes.FirstOrDefault(d => d <= finSemana1);
                var marSem1 = todosLosMartes.FirstOrDefault(d => d <= finSemana1);
                var mieSem1 = todosLosMiercoles.FirstOrDefault(d => d <= finSemana1);
                var jueSem1 = todosLosJueves.FirstOrDefault(d => d <= finSemana1);
                var vieSem1 = todosLosViernes.FirstOrDefault(d => d <= finSemana1);

                var lunSem2 = todosLosLunes.FirstOrDefault(d => d > finSemana1);
                var marSem2 = todosLosMartes.FirstOrDefault(d => d > finSemana1);
                var mieSem2 = todosLosMiercoles.FirstOrDefault(d => d > finSemana1);
                var jueSem2 = todosLosJueves.FirstOrDefault(d => d > finSemana1);
                var vieSem2 = todosLosViernes.FirstOrDefault(d => d > finSemana1);

                var totalMinutos = (emp.HorasAusente * 60) + emp.MinutosAusente;
                var montoDescuento = totalMinutos * 0.0275;

                <tr>
                    <td rowspan="2">@count</td>
                    <td rowspan="2" class="fw-bold">@emp.Codigo</td>
                    <td rowspan="2" class="text-start ps-2">@emp.Nombre</td>
                    <td>@(lunSem1 != default ? lunSem1.ToString("dd-MMM") : "")</td>
                    <td>@(marSem1 != default ? marSem1.ToString("dd-MMM") : "")</td>
                    <td>@(mieSem1 != default ? mieSem1.ToString("dd-MMM") : "")</td>
                    <td>@(jueSem1 != default ? jueSem1.ToString("dd-MMM") : "")</td>
                    <td>@(vieSem1 != default ? vieSem1.ToString("dd-MMM") : "")</td>
                    <td rowspan="2">
                        <div class="time-input-group" data-opid="@emp.Codigo" data-period="@Model.Periodo.Id">
                            <input type="number" class="input-time in-h" value="@emp.HorasAusente" min="0" oninput="calcularDescuento(this)">
                            <b>:</b>
                            <input type="number" class="input-time in-m" value="@emp.MinutosAusente" min="0" max="59" oninput="calcularDescuento(this)">
                        </div>
                    </td>
                    <td rowspan="2">
                        <span class="label-descuento">$ @montoDescuento.ToString("F2")</span>
                    </td>
                    <td class="text-start p-1">
                        <div class="editable-motivo" contenteditable="true" data-opid="@emp.Codigo" data-period="@Model.Periodo.Id" data-semana="1" onblur="saveObservation(this)">
                            @(registroSem1?.Motivo ?? "")
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>@(lunSem2 != default ? lunSem2.ToString("dd-MMM") : "")</td>
                    <td>@(marSem2 != default ? marSem2.ToString("dd-MMM") : "")</td>
                    <td>@(mieSem2 != default ? mieSem2.ToString("dd-MMM") : "")</td>
                    <td>@(jueSem2 != default ? jueSem2.ToString("dd-MMM") : "")</td>
                    <td>@(vieSem2 != default ? vieSem2.ToString("dd-MMM") : "")</td>
                    <td class="text-start p-1">
                        <div class="editable-motivo" contenteditable="true" data-opid="@emp.Codigo" data-period="@Model.Periodo.Id" data-semana="2" onblur="saveObservation(this)">
                            @(registroSem2?.Motivo ?? "")
                        </div>
                    </td>
                </tr>
                count++;
            }
        </tbody>
    </table>

    <div class="container-fluid text-center mt-5" style="page-break-inside: avoid; font-family: Arial;">
        <div class="row">
            <div class="col-4">
                <div style="border-top: 1px solid black; width: 85%; margin: 0 auto; margin-bottom: 4px;"></div>
                <div class="fw-bold" style="font-size: 11px;">Elaborado por: Willian Alexander</div>
                <div style="font-size: 11px; color: #333;">Digitador</div>
            </div>
            <div class="col-4">
                <div style="border-top: 1px solid black; width: 85%; margin: 0 auto; margin-bottom: 4px;"></div>
                <div class="fw-bold" style="font-size: 11px;">Revisado por: Ing. Luis Alonso Barahona</div>
                <div style="font-size: 11px; color: #333;">Jefe de Confección y Empaque</div>
            </div>
            <div class="col-4">
                <div style="border-top: 1px solid black; width: 85%; margin: 0 auto; margin-bottom: 4px;"></div>
                <div class="fw-bold" style="font-size: 11px;">Autorizado por: Ing. Johanna Quiñónez</div>
                <div style="font-size: 11px; color: #333;">Directora de Producción</div>
            </div>
        </div>
    </div>

    <script>
        function calcularDescuento(el) {
            const group = el.closest('.time-input-group');
            const row = el.closest('tr');
            const h = parseInt(group.querySelector('.in-h').value) || 0;
            const m = parseInt(group.querySelector('.in-m').value) || 0;
            const totalMinutos = (h * 60) + m;
            const monto = totalMinutos * 0.0275;

            row.querySelector('.label-descuento').innerText = "$ " + monto.toFixed(2);

            fetch('/Ausentismo/GuardarHorasEmpaque', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    OperatorCode: group.getAttribute('data-opid'),
                    PeriodId: parseInt(group.getAttribute('data-period')),
                    Hours: h,
                    Minutes: m
                })
            });
        }

        function saveObservation(element) {
            const text = element.innerText.trim();
            element.classList.add('saving');
            fetch('/Ausentismo/GuardarObservacion', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    OperatorCode: element.getAttribute('data-opid'),
                    PeriodId: parseInt(element.getAttribute('data-period')),
                    Observation: text,
                    SemanaNumero: parseInt(element.getAttribute('data-semana') || "1")
                })
            }).then(() => element.classList.remove('saving'));
        }

        const input = document.getElementById('periodSearchInput');
        const container = document.getElementById('periodSearchResults');
        input.addEventListener('input', function() {
            const searchText = this.value.toLowerCase().trim();
            if (searchText.length === 0) { container.style.display = 'none'; return; }
            document.querySelectorAll('.search-item').forEach(item => {
                if (item.getAttribute('data-filter').includes(searchText)) {
                    item.style.display = 'block';
                } else item.style.display = 'none';
            });
            container.style.display = 'block';
        });

        document.querySelectorAll('.search-item').forEach(item => {
            item.addEventListener('click', function() {
                window.location.href = '/Ausentismo/ReporteMecanicosHoras?periodId=' + this.getAttribute('data-id');
            });
            });<script>
