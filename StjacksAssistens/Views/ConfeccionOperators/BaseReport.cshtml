@model StjacksAssistens.ViewModels.BaseReportViewModel

@{
    ViewData["Title"] = "Base General y Reportes por Líneas";
}

<div class="container-fluid py-3">

    <!-- ENCABEZADO GENERAL (Se oculta al imprimir) -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print border-bottom pb-3">
        <div>
            <h4 class="fw-bold text-primary mb-1"><i class="bi bi-journal-richtext me-2"></i> Base General y Formatos por Líneas</h4>
            <p class="text-muted small mb-0">Consulta general del personal y formatos idénticos listos para impresión por línea.</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "ConfeccionOperators")" class="btn btn-outline-secondary btn-sm me-2 shadow-sm">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>

    <!-- DISTRIBUCIÓN EN 2 COLUMNAS -->
    <div class="row g-4">

        <!-- COLUMNA IZQUIERDA: LA BASE GENERAL -->
        <div class="col-xl-5 col-lg-6 no-print">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-primary text-white py-3 rounded-top-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-people me-2"></i> Listado General de Personal</h5>
                    <span class="badge bg-light text-primary">Total: @(Model.Operators?.Count() ?? 0)</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 700px; overflow-y: auto;">
                        <table class="table table-hover table-striped align-middle mb-0 fs-7">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th class="ps-3">Cód</th>
                                    <th>Nombre Completo</th>
                                    <th>Área</th>
                                    <th class="pe-3">Línea</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Operators != null && Model.Operators.Any())
                                {
                                    @foreach (var op in Model.Operators)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-bold text-secondary">@op.Code</td>
                                            <td class="fw-semibold">@op.Name</td>
                                            <td><span class="badge bg-light text-dark border">@(op.Area?.Name ?? "N/A")</span></td>
                                            <td class="pe-3 text-muted small">@(op.Linea?.Name ?? "Sin asignar")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">No hay operarios registrados.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA: FORMATOS IDÉNTICOS AL EXCEL -->
        <div class="col-xl-7 col-lg-6">
            <div class="mb-3 no-print">
                <h5 class="fw-bold text-dark"><i class="bi bi-layers-half me-2"></i> Formatos de Líneas</h5>
                <p class="text-muted small">Cada formato cuenta con su botón de impresión individual.</p>
            </div>

            <div class="d-flex flex-column gap-4">
                @if (Model.Lines != null && Model.Lines.Any())
                {
                    @foreach (var linea in Model.Lines)
                    {
                        var lineaId = linea.Id;
                        var lineaNombre = linea.Name ?? "SIN LÍNEA";
                        var operariosLinea = Model.Operators?.Where(o => o.LineaId == lineaId).ToList() ?? new List<StjacksAssistens.ConfeccionModels.Operators>();

                        <!-- TARJETA CON EL DISEÑO EXACTO AL FORMATO DE EXCEL -->
                        <div class="card shadow-sm border rounded-3 p-3 bg-white report-sheet" id="sheet-@lineaId">

                            <!-- CABECERA SUPERIOR: PLANTA, FECHA Y CUADRO DE ENGRAPAR -->
                            <div class="row align-items-center mb-2">
                                <div class="col-4 fw-bold" style="font-size: 13px; color: #000;">PLANTA # 2</div>
                                <div class="col-4 text-center" style="font-size: 13px; color: #000;">
                                    <strong>FECHA:</strong> <span style="border-bottom: 1.5px solid #000; padding: 0 15px; display: inline-block;">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="col-4 text-end">
                                    <div style="border: 1.5px solid #000; padding: 4px 8px; font-weight: bold; background-color: #f8f9fa; text-align: center; display: inline-block; font-size: 11px; color: #000;">ENGRAPAR AQUÍ</div>
                                </div>
                            </div>

                            <!-- TÍTULO Y BOTÓN DE IMPRESIÓN -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold m-0 text-uppercase" style="font-size: 14px; letter-spacing: 0.5px; color: #000;">REPORTE DE HORAS TICKETS DIARIO</h6>
                                <button onclick="printSpecificSheet('sheet-@lineaId')" class="btn btn-dark btn-sm no-print shadow-sm py-1 px-2" style="font-size: 11px;">
                                    <i class="bi bi-printer me-1"></i> Imprimir esta Línea
                                </button>
                            </div>

                            <!-- LÍNEA # -->
                            <div class="mb-2" style="font-size: 13px; color: #000;">
                                <strong>LÍNEA #</strong> <span style="border-bottom: 1.5px solid #000; padding: 0 20px; display: inline-block; font-weight: bold; text-transform: uppercase;">@lineaNombre</span>
                            </div>

                            <!-- SUPERVISOR (A) -->
                            <div class="mb-3" style="font-size: 13px; color: #000;">
                                <strong>SUPERVISOR (A) :</strong> <span style="border-bottom: 1.5px solid #000; display: inline-block; width: 50%;">&nbsp;</span>
                            </div>

                            <!-- TABLA DE OPERARIOS Y AJUSTES -->
                            <div class="table-responsive">
                                <table style="width: 100%; border-collapse: collapse !important; border: 1.5px solid #000 !important; text-align: center; font-size: 11px;" class="custom-report-table mb-0">
                                    <thead>
                                        <tr style="background-color: #e9ecef;">
                                            <th rowspan="2" style="border: 1px solid #000 !important; width: 6%; padding: 5px; color: #000;">#</th>
                                            <th rowspan="2" style="border: 1px solid #000 !important; width: 14%; padding: 5px; color: #000;">CODIGO</th>
                                            <th rowspan="2" style="border: 1px solid #000 !important; width: 32%; padding: 5px; color: #000;">NOMBRE</th>
                                            <th rowspan="2" style="border: 1px solid #000 !important; width: 10%; padding: 5px; color: #000;"># Placa</th>
                                            <th colspan="3" style="border: 1px solid #000 !important; padding: 5px; color: #000;">Ajuste de Máquina</th>
                                            <th rowspan="2" style="border: 1px solid #000 !important; width: 14%; padding: 5px; color: #000;">ISSS / PP</th>
                                        </tr>
                                        <tr style="background-color: #e9ecef;">
                                            <th style="border: 1px solid #000 !important; width: 8%; padding: 4px; color: #000;">Desde</th>
                                            <th style="border: 1px solid #000 !important; width: 8%; padding: 4px; color: #000;">Hasta</th>
                                            <th style="border: 1px solid #000 !important; width: 8%; padding: 4px; color: #000;">Tiempo (min)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int contador = 1;
                                            foreach (var op in operariosLinea)
                                            {
                                                <tr style="height: 25px;">
                                                    <td style="border: 1px solid #000 !important; font-weight: bold; color: #000;">@contador</td>
                                                    <td style="border: 1px solid #000 !important; color: #000;">@op.Code</td>
                                                    <td style="border: 1px solid #000 !important; text-align: left; padding-left: 8px; text-transform: uppercase; font-size: 11px; font-weight: 500; color: #000;">@op.Name</td>
                                                    <td style="border: 1px solid #000 !important;"></td>
                                                    <td style="border: 1px solid #000 !important;"></td>
                                                    <td style="border: 1px solid #000 !important;"></td>
                                                    <td style="border: 1px solid #000 !important;"></td>
                                                    <td style="border: 1px solid #000 !important;"></td>
                                                </tr>
                                                contador++;
                                            }

                                            int totalFilasRelleno = 13;
                                            for (int i = contador; i <= totalFilasRelleno; i++)
                                            {
                                                <tr style="height: 25px;">
                                                    <td style="border: 1px solid #000 !important; font-weight: bold; color: #000;">@i</td>
                                                    <td style="border: 1px solid #000 !important; color: #000;">&nbsp;</td>
                                                    <td style="border: 1px solid #000 !important;"></td>
                                                    <td style="border: 1px solid #000 !important;"></td>
                                                    <td style="border: 1px solid #000 !important;"></td>
                                                    <td style="border: 1px solid #000 !important;"></td>
                                                    <td style="border: 1px solid #000 !important;"></td>
                                                    <td style="border: 1px solid #000 !important;"></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning text-center">No se encontraron líneas de producción activas.</div>
                }
            </div>
        </div>

    </div>
</div>

<!-- SCRIPT DE IMPRESIÓN AISLADA -->
<script>
    function printSpecificSheet(sheetId) {
        var sheetContent = document.getElementById(sheetId).innerHTML;
        var originalBody = document.body.innerHTML;

        document.body.innerHTML = `
            <div style="padding: 10px; font-family: Arial, sans-serif; background-color: white;">
                ${sheetContent}
            </div>
        `;

        window.print();

        document.body.innerHTML = originalBody;
        location.reload();
    }
</script>

<style>
    @@media print {
        .no-print {
            display: none !important;
        }
    }
</style>