@using Microsoft.EntityFrameworkCore
@using System.Linq
@using System.Globalization
@inject StjacksAssistens.Data.ApplicationDbContext _context

@{
    ViewData["Title"] = "Consolidado de Ausentismo";
    var periodoActivo = await _context.Set<Periodss>().OrderByDescending(p => p.Id).FirstOrDefaultAsync();

    // Lista de líneas según tu estructura de categorías
    var todasLasLineas = await _context.Set<Category>()
        .Where(c => c.Name != "Confeccion" && c.Name != "Empaque" && c.Name != "Digitador" && c.Name != "Supervisor" && c.Name != "Mecanicos")
        .OrderBy(c => c.Name).ToListAsync();

    var datosBD = await _context.Set<Attendence>()
        .Include(a => a.Operator).ThenInclude(o => o.Linea)
        .Where(a => a.PeriodId == periodoActivo.Id && a.Status != "X")
        .ToListAsync();

    var reporteCompleto = new List<dynamic>();

    // Generar reporte consecutivo por fecha y línea
    for (var d = periodoActivo.StartDate; d <= periodoActivo.EndDate; d = d.AddDays(1))
    {
        if (d.DayOfWeek == DayOfWeek.Saturday || d.DayOfWeek == DayOfWeek.Sunday) continue;

        foreach (var linea in todasLasLineas)
        {
            var registros = datosBD.Where(a => a.AttendanceDate.Date == d.Date && a.Operator?.Linea?.Name == linea.Name).ToList();

            reporteCompleto.Add(new
            {
                Fecha = d,
                Linea = linea.Name,
                Incapacidad = registros.Where(x => x.Status == "INC").Sum(x => (double)(x.Hours ?? 8.5) + ((x.Minutes ?? 0) / 60.0)),
                Permiso = registros.Where(x => x.Status == "PP").Sum(x => (double)(x.Hours ?? 0) + ((x.Minutes ?? 0) / 60.0)),
                Clinica = registros.Where(x => x.Status == "CLINICA").Sum(x => (double)(x.Hours ?? 0) + ((x.Minutes ?? 0) / 60.0)),
                ISSS = registros.Where(x => x.Status == "ISSS").Sum(x => (double)(x.Hours ?? 0) + ((x.Minutes ?? 0) / 60.0))
            });
        }
    }
}

<div class="container-fluid mt-4">
    <table class="table table-bordered table-excel">
        <thead class="table-dark">
            <tr>
                <th>FECHA</th>
                <th>MES</th>
                <th>LINEA</th>
                <th>INCAPACIDAD</th>
                <th>PERMISO</th>
                <th>CLINICA</th>
                <th>ISSS</th>
                <th>TOTAL MINUTOS</th>
                <th>MODA PARCIAL</th>
                <th>MODA TOTAL</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in reporteCompleto)
            {
                double totHoras = item.Incapacidad + item.Permiso + item.Clinica + item.ISSS;
                double totMin = totHoras * 60;
                int modaParcial = totHoras > 0 ? 1 : 0;
                double modaTotal = totHoras / 510.0;

                <tr>
                    <td>@item.Fecha.ToString("d-MMM-yy")</td>
                    <td>@item.Fecha.ToString("MMMM yyyy")</td>
                    <td>@item.Linea</td>
                    <td>@(item.Incapacidad > 0 ? item.Incapacidad.ToString("0.0") : "")</td>
                    <td>@(item.Permiso > 0 ? item.Permiso.ToString("0.0") : "")</td>
                    <td>@(item.Clinica > 0 ? item.Clinica.ToString("0.0") : "")</td>
                    <td>@(item.ISSS > 0 ? item.ISSS.ToString("0.0") : "")</td>
                    <td class="fw-bold">@(totMin > 0 ? totMin.ToString("0.0") : "")</td>
                    <td>@modaParcial</td>
                    <td>@(modaTotal > 0 ? modaTotal.ToString("0.00") : "")</td>
                </tr>
            }
        </tbody>
    </table>
</div>