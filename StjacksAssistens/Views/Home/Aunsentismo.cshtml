@model StjacksAssistens.ConfeccionModels.AusentismoDashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Ausentismo por Línea";
    var cultura = CultureInfo.GetCultureInfo("es-SV");
    Func<double, string> h = v => v > 0 ? v.ToString("0.##", cultura) : "";
    // Nivel de intensidad para el mapa de calor según minutos perdidos.
    Func<double, int> nivel = m => m <= 0 ? 0 : m <= 255 ? 1 : m <= 510 ? 2 : m <= 1020 ? 3 : 4;
    var hayDatos = Model.Filas != null && Model.Filas.Any();
}

<style>
    .aus-kpi {
        border: none;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 4px 20px rgba(15,23,42,.06);
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .aus-kpi:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(15,23,42,.10);
        }

        .aus-kpi .ic {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            font-size: 1.25rem;
            color: #fff;
        }

    .g-red {
        background: linear-gradient(135deg,#f43f5e,#e11d48);
    }

    .g-blue {
        background: linear-gradient(135deg,#4361ee,#3b82f6);
    }

    .g-amber {
        background: linear-gradient(135deg,#f59e0b,#d97706);
    }

    .g-teal {
        background: linear-gradient(135deg,#2ec4b6,#0d9488);
    }

    .aus-kpi .val {
        font-size: 1.6rem;
        font-weight: 800;
        line-height: 1;
        color: #0f172a;
    }

    .aus-kpi .lbl {
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .04em;
        color: #94a3b8;
        text-transform: uppercase;
    }

    .chart-box {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(15,23,42,.06);
        padding: 1.1rem 1.25rem;
        height: 100%;
    }

        .chart-box h6 {
            font-weight: 700;
            font-size: .95rem;
            margin-bottom: .75rem;
            color: #334155;
        }

    .chart-canvas-wrap {
        position: relative;
        height: 220px;
    }

    /* ---- Mapa de calor ---- */
    .heat {
        border-collapse: separate;
        border-spacing: 4px;
        width: 100%;
    }

        .heat th {
            font-size: .68rem;
            color: #64748b;
            font-weight: 600;
            text-align: center;
            padding: 2px;
            white-space: nowrap;
        }

        .heat td.lineh {
            font-size: .78rem;
            font-weight: 700;
            color: #334155;
            text-align: center;
        }

        .heat .cell {
            height: 30px;
            border-radius: 6px;
            text-align: center;
            vertical-align: middle;
            font-size: .7rem;
            font-weight: 600;
            color: #fff;
            cursor: default;
        }

    .lvl0 {
        background: #f1f5f9;
    }

    .lvl1 {
        background: #fde68a;
        color: #78350f;
    }

    .lvl2 {
        background: #fb923c;
    }

    .lvl3 {
        background: #ef4444;
    }

    .lvl4 {
        background: #991b1b;
    }

    .heat-legend span {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-size: .72rem;
        color: #64748b;
        margin-right: .75rem;
    }

    .heat-legend i {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        display: inline-block;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        #detalle {
            display: block !important;
        }
    }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 mt-3">
    <div>
        <h3 class="fw-bold mb-0"><i class="bi bi-graph-down-arrow text-danger me-2"></i>Ausentismo por Línea</h3>
        <p class="text-muted small mb-0">Periodo: <strong>@Model.Periodo</strong></p>
    </div>
    <div class="no-print d-flex gap-2">
        <a asp-action="AunsentismoCsv" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-excel"></i> Exportar CSV
        </a>
        <button onclick="window.print()" class="btn btn-dark btn-sm">
            <i class="bi bi-printer"></i> Imprimir
        </button>
    </div>
</div>

@if (!hayDatos)
{
    <div class="alert alert-info">No hay un periodo activo con datos de asistencia.</div>
}
else
{
    <!-- ============ KPIs ============ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="aus-kpi p-3 h-100 d-flex align-items-center gap-3">
                <div class="ic g-red"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="val">@Model.TotalMinutos.ToString("N0", cultura)</div>
                    <div class="lbl">Minutos perdidos</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="aus-kpi p-3 h-100 d-flex align-items-center gap-3">
                <div class="ic g-blue"><i class="bi bi-calendar-x"></i></div>
                <div>
                    <div class="val">@Model.JornadasEquivalentes.ToString("0.0", cultura)</div>
                    <div class="lbl" title="1 jornada = 510 minutos (8.5 h)">Jornadas equivalentes</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="aus-kpi p-3 h-100 d-flex align-items-center gap-3">
                <div class="ic g-amber"><i class="bi bi-diagram-3"></i></div>
                <div>
                    <div class="val">Línea @Model.LineaTop</div>
                    <div class="lbl">Más afectada · @Model.LineaTopMinutos.ToString("N0", cultura) min</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="aus-kpi p-3 h-100 d-flex align-items-center gap-3">
                <div class="ic g-teal"><i class="bi bi-pie-chart"></i></div>
                <div>
                    <div class="val" style="font-size:1.15rem;">@Model.CategoriaTop</div>
                    <div class="lbl">Categoría dominante · @Model.CategoriaTopMinutos.ToString("N0", cultura) min</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ Gráficos ============ -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="chart-box">
                <h6>Reparto por categoría</h6>
                <div class="chart-canvas-wrap"><canvas id="chartCategoria"></canvas></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="chart-box">
                <h6>Líneas más afectadas</h6>
                <div class="chart-canvas-wrap"><canvas id="chartLineas"></canvas></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="chart-box">
                <h6>Tendencia diaria (min)</h6>
                <div class="chart-canvas-wrap"><canvas id="chartDias"></canvas></div>
            </div>
        </div>
    </div>

    <!-- ============ Mapa de calor ============ -->
    <div class="chart-box mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
            <h6 class="mb-0">Mapa de calor · Líneas × Días <span class="text-muted fw-normal small">(minutos perdidos)</span></h6>
            <div class="heat-legend no-print">
                <span><i class="lvl0"></i> Sin ausencias</span>
                <span><i class="lvl1"></i> Leve</span>
                <span><i class="lvl2"></i> ≤ 1 jornada</span>
                <span><i class="lvl3"></i> Alta</span>
                <span><i class="lvl4"></i> Crítica</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="heat">
                <thead>
                    <tr>
                        <th></th>
                        @foreach (var d in Model.Dias)
                        {
                            <th>@d.ToString("dd-MMM", cultura)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linea in Model.Lineas)
                    {
                        <tr>
                            <td class="lineh">L@(linea)</td>
                            @foreach (var d in Model.Dias)
                            {
                                var min = Model.Celdas.TryGetValue($"{linea}|{d:yyyy-MM-dd}", out var v) ? v : 0;
                                var lv = nivel(min);
                                <td class="cell lvl@(lv)" title="Línea @linea · @d.ToString("dd-MMM", cultura): @min.ToString("N0", cultura) min">
                                    @(min > 0 ? min.ToString("N0", cultura) : "")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ============ Detalle (colapsable) ============ -->
    <div class="chart-box">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 no-print">
            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#detalle">
                <i class="bi bi-table"></i> Ver detalle (tabla)
            </button>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="soloConDatos" checked>
                    <label class="form-check-label small" for="soloConDatos">Ocultar filas sin ausencias</label>
                </div>
                <select id="filtroLinea" class="form-select form-select-sm" style="width:auto;">
                    <option value="">Todas las líneas</option>
                    @foreach (var linea in Model.Lineas)
                    {
                        <option value="@linea">Línea @linea</option>
                    }
                </select>
            </div>
        </div>

        <div id="detalle" class="collapse">
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle text-center mb-0" id="tablaDetalle">
                    <thead class="table-dark">
                        <tr>
                            <th>FECHA</th>
                            <th>MES</th>
                            <th>LÍNEA</th>
                            <th>INCAP.</th>
                            <th>PERMISO</th>
                            <th>CLÍNICA</th>
                            <th>ISSS</th>
                            <th>TOTAL MIN</th>
                            <th title="Cuántas categorías de ausencia tuvieron valor ese día">Categorías afectadas</th>
                            <th title="Minutos ÷ 510 (una jornada completa = 8.5 h)">Jornadas equiv.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Filas)
                        {
                            <tr data-linea="@f.Linea" data-total="@f.TotalMinutos.ToString(CultureInfo.InvariantCulture)">
                                <td>@f.Fecha.ToString("d-MMM-yy", cultura)</td>
                                <td>@f.Fecha.ToString("MMMM yyyy", cultura)</td>
                                <td class="fw-bold">@f.Linea</td>
                                <td>@h(f.Incapacidad)</td>
                                <td>@h(f.PermisoPersonal)</td>
                                <td>@h(f.Clinica)</td>
                                <td>@h(f.ISSS)</td>
                                <td class="fw-bold">@(f.TotalMinutos > 0 ? f.TotalMinutos.ToString("N1", cultura) : "-")</td>
                                <td>@f.ModaParcial</td>
                                <td>@(f.ModaTotal > 0 ? f.ModaTotal.ToString("0.00", cultura) : "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const datos = {
            categoria: @Html.Raw(Json.Serialize(Model.PorCategoria)),
            lineas: @Html.Raw(Json.Serialize(Model.PorLinea)),
            dias: @Html.Raw(Json.Serialize(Model.PorDia))
        };

        // ---- Dona: reparto por categoría ----
        const catLabels = Object.keys(datos.categoria).filter(k => datos.categoria[k] > 0);
        if (catLabels.length) {
            new Chart(document.getElementById('chartCategoria'), {
                type: 'doughnut',
                data: {
                    labels: catLabels,
                    datasets: [{
                        data: catLabels.map(k => datos.categoria[k]),
                        backgroundColor: ['#ef4444', '#f59e0b', '#3b82f6', '#8b5cf6'],
                        borderWidth: 2, borderColor: '#fff'
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, cutout: '60%',
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } } }
            });
        }

        // ---- Barras: líneas más afectadas (top con datos) ----
        const linCon = datos.lineas.filter(l => l.valor > 0);
        if (linCon.length) {
            new Chart(document.getElementById('chartLineas'), {
                type: 'bar',
                data: {
                    labels: linCon.map(l => 'L' + l.etiqueta),
                    datasets: [{ label: 'Minutos', data: linCon.map(l => l.valor),
                        backgroundColor: '#4361ee', borderRadius: 6 }]
                },
                options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: { x: { grid: { color: '#eef2f7' } }, y: { grid: { display: false } } } }
            });
        }

        // ---- Línea: tendencia diaria ----
        new Chart(document.getElementById('chartDias'), {
            type: 'line',
            data: {
                labels: datos.dias.map(d => d.etiqueta),
                datasets: [{ label: 'Minutos', data: datos.dias.map(d => d.valor),
                    borderColor: '#2ec4b6', backgroundColor: 'rgba(46,196,182,.12)',
                    fill: true, tension: .35, borderWidth: 3, pointRadius: 3 }]
            },
            options: { responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, grid: { color: '#eef2f7' } }, x: { grid: { display: false } } } }
        });

        // ---- Filtros de la tabla de detalle ----
        const chkSolo = document.getElementById('soloConDatos');
        const selLinea = document.getElementById('filtroLinea');
        function aplicarFiltros() {
            const soloDatos = chkSolo.checked;
            const linea = selLinea.value;
            document.querySelectorAll('#tablaDetalle tbody tr').forEach(tr => {
                const tieneDatos = parseFloat(tr.dataset.total) > 0;
                const okDatos = !soloDatos || tieneDatos;
                const okLinea = !linea || tr.dataset.linea === linea;
                tr.style.display = (okDatos && okLinea) ? '' : 'none';
            });
        }
        chkSolo.addEventListener('change', aplicarFiltros);
        selLinea.addEventListener('change', aplicarFiltros);
        aplicarFiltros();
    </script>
}
