@using Microsoft.EntityFrameworkCore
@using System.Linq
@using System.Globalization
@inject StjacksAssistens.Data.ApplicationDbContext _context

@{
    ViewData["Title"] = "Consolidado de Ausentismo";

    // CARGAMOS TODOS LOS DATOS SIN FILTRAR POR PERIODO
    var datosBD = _context.Set<Attendence>()
        .Include(a => a.Operator).ThenInclude(o => o.Linea)
        .ToList();

    var todosLosPeriodos = _context.Set<Periodss>().OrderBy(p => p.StartDate).ToList();
    var todasLasLineas = _context.Set<Category>().OrderBy(c => c.Name).ToList();

    var reporteCompleto = new List<dynamic>();

    // RECORREMOS CADA PERIODO PARA MANTENER EL ORDEN Y LA ESTRUCTURA
    foreach (var p in todosLosPeriodos)
    {
        for (var d = p.StartDate; d <= p.EndDate; d = d.AddDays(1))
        {
            if (d.DayOfWeek == DayOfWeek.Saturday || d.DayOfWeek == DayOfWeek.Sunday) continue;

            foreach (var linea in todasLasLineas)
            {
                var registros = datosBD.Where(a => a.AttendanceDate.Date == d.Date &&
                                              a.Operator?.Linea?.Name == linea.Name).ToList();

                // Lógica de suma flexible que detecta cualquier variante
                double GetSum(string[] tipos) => registros
                    .Where(x => x.Status != null && tipos.Contains(x.Status.Trim().ToUpper()))
                    .Sum(x => (double)(x.Hours ?? 0) + ((x.Minutes ?? 0) / 60.0));

                var inc = GetSum(new[] { "INC", "INCAPACIDAD" });
                var pp = GetSum(new[] { "PP", "PERMISO" });
                var clin = GetSum(new[] { "CLINICA", "CL" });
                var iss = GetSum(new[] { "ISSS", "SEGURO", "SEGURO SOCIAL" });

                // Agregamos siempre la fila para que aparezcan las fechas
                reporteCompleto.Add(new
                {
                    Periodo = p.Id,
                    Fecha = d,
                    Linea = linea.Name,
                    Incapacidad = inc,
                    Permiso = pp,
                    Clinica = clin,
                    ISSS = iss
                });
            }
        }
    }
}

<div class="container-fluid mt-4">
    <table class="table table-bordered table-excel">
        <thead class="table-dark">
            <tr>
                <th>PERIODO</th>
                <th>FECHA</th>
                <th>LINEA</th>
                <th>INC</th>
                <th>PP</th>
                <th>CLINICA</th>
                <th>ISSS</th>
                <th>TOTAL MIN</th>
                <th>MODA TOTAL</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in reporteCompleto)
            {
                double totHoras = (double)item.Incapacidad + (double)item.Permiso + (double)item.Clinica + (double)item.ISSS;
                double totMin = totHoras * 60;
                double modaTotal = (totMin > 0) ? totMin / 510.0 : 0;

                <tr>
                    <td>@item.Periodo</td>
                    <td>@item.Fecha.ToString("d-MMM-yy")</td>
                    <td>@item.Linea</td>
                    <td>@(item.Incapacidad > 0 ? ((double)item.Incapacidad).ToString("0.0") : "")</td>
                    <td>@(item.Permiso > 0 ? ((double)item.Permiso).ToString("0.0") : "")</td>
                    <td>@(item.Clinica > 0 ? ((double)item.Clinica).ToString("0.0") : "")</td>
                    <td>@(item.ISSS > 0 ? ((double)item.ISSS).ToString("0.0") : "")</td>
                    <td class="fw-bold">@(totMin > 0 ? totMin.ToString("0.0") : "")</td>
                    <td>@(modaTotal > 0 ? modaTotal.ToString("0.00") : "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>