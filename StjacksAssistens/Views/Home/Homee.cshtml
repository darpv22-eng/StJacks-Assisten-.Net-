@{
    ViewData["Title"] = "Selección de Área Operativa";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    :root {
        --st-primary: #4361ee;
        --st-secondary: #7209b7;
        --st-bg: #f8f9fa;
    }

    .selector-container {
        background: var(--st-bg);
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .area-card {
        background: #ffffff;
        border: none;
        border-radius: 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        transition: all 0.4s ease;
        text-decoration: none !important;
        overflow: hidden;
        position: relative;
        border: 2px solid transparent;
    }

        .area-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(67, 97, 238, 0.12);
            border-color: var(--st-primary);
        }

    .area-icon-wrapper {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 1.5rem;
        font-size: 2.2rem;
        margin-bottom: 1.5rem;
        transition: transform 0.3s ease;
    }

    .area-card:hover .area-icon-wrapper {
        transform: scale(1.1);
    }

    .bg-grad-confeccion {
        background: linear-gradient(135deg, #4361ee, #4895ef);
        color: white;
    }

    .bg-grad-tintoreria {
        background: linear-gradient(135deg, #7209b7, #b5179e);
        color: white;
    }
</style>

<div class="selector-container">
    <div class="container">
        <!-- Cabecera de bienvenida -->
        <div class="row justify-content-center text-center mb-5">
            <div class="col-md-8">
                <span class="badge px-3 py-2 rounded-pill mb-3" style="background-color: rgba(67, 97, 238, 0.1); color: var(--st-primary); font-weight: 600;">
                    St. Jack's Core - Panel Central
                </span>
                <h1 class="fw-bold display-5 mb-2">Seleccione el Área de Trabajo</h1>
                <p class="text-muted">Elija el módulo operativo al que desea ingresar para gestionar la producción y el personal en tiempo real.</p>
            </div>
        </div>

        <!-- Tarjetas de Selección -->
        <div class="row g-4 justify-content-center">

            <!-- Módulo 1: Confección y Empaque -->
            <div class="col-md-5 col-lg-4">
                <a asp-controller="Home" asp-action="Index" class="card area-card p-4 h-100 d-block text-dark">
                    <div class="card-body d-flex flex-column align-items-center text-center p-3">
                        <div class="area-icon-wrapper bg-grad-confeccion shadow-sm">
                            <i class="bi bi-scissors"></i>
                        </div>
                        <h3 class="fw-bold mb-2">Confección y Empaque</h3>
                        <p class="text-muted small mb-4">Control de líneas de costura, control de asistencia de operarios, metas de piezas terminadas y estampado.</p>
                        <div class="mt-auto">
                            <span class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                                Ingresar <i class="bi bi-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Módulo 2: Tintorería -->
            <div class="col-md-5 col-lg-4">
                <a asp-controller="Home" asp-action="DashboardTintoreria" class="card area-card p-4 h-100 d-block text-dark">
                    <div class="card-body d-flex flex-column align-items-center text-center p-3">
                        <div class="area-icon-wrapper bg-grad-tintoreria shadow-sm">
                            <i class="bi bi-droplet-half"></i>
                        </div>
                        <h3 class="fw-bold mb-2">Tintorería</h3>
                        <p class="text-muted small mb-4">Gestión de procesos químicos, control de libras procesadas, lotes, estados y rendimiento del área de tinte.</p>
                        <div class="mt-auto">
                            <span class="btn btn-outline-secondary rounded-pill px-4 fw-bold" style="color: var(--st-secondary); border-color: var(--st-secondary);">
                                Ingresar <i class="bi bi-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </div>
                </a>
            </div>

        </div>
    </div>
</div>