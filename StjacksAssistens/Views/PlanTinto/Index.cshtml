@model IEnumerable<StjacksAssistens.TintoModels.PlanDelivery>

@{
    ViewData["Title"] = "Plan de Entregas - Formato Excel";
}

<div class="container-fluid px-4 py-4">
    <!-- Encabezado del Sistema -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-file-earmark-excel text-success me-2"></i>Plan de Entregas de Tintorería</h2>
            <p class="text-muted mb-0">Gestión de lotes y control de entregas basado en estructura de hoja de cálculo.</p>
        </div>
    </div>

    <!-- Alertas de Sistema -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Panel de Carga de Excel -->
    <div class="row mb-4">
        <div class="col-xl-6 col-lg-8">
            <div class="card shadow-sm border rounded-3 bg-light">
                <div class="card-body p-3">
                    <form asp-controller="PlanTinto" asp-action="SubirExcel" method="post" enctype="multipart/form-data" class="row g-2 align-items-center">
                        @Html.AntiForgeryToken()
                        <div class="col-md-8">
                            <input type="file" class="form-control form-control-sm bg-white" id="archivoExcel" name="archivoExcel" accept=".xlsx, .xls" required />
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-success btn-sm w-100 fw-semibold shadow-sm">
                                <i class="bi bi-upload me-1"></i> Cargar Excel
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenedor Principal Estilo Hoja de Excel -->
    <div class="card shadow-sm border rounded-0">
        <div class="card-header bg-secondary text-white py-2 px-3 d-flex justify-content-between align-items-center rounded-0">
            <span class="fw-bold small"><i class="bi bi-table me-2"></i> Plan de Entrega - Vista de Datos</span>
            <span class="badge bg-dark border text-white px-2 py-1">
                Total Registros: @(Model != null ? Model.Count() : 0)
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 700px; overflow-y: auto;">
                <table class="table table-bordered table-sm align-middle mb-0" style="font-size: 0.9rem; border-color: #dee2e6;">
                    <thead style="background-color: #e9ecef; position: sticky; top: 0; z-index: 1;">
                        <tr class="text-secondary text-center">
                            <th class="py-2" style="width: 50px;">#</th>
                            <th class="py-2 text-start ps-3">Fecha de Entrega</th>
                            <th class="py-2 text-start ps-3">Lotes</th>
                            <th class="py-2 text-start ps-3">Color / Descripción</th>
                            <th class="py-2 text-end pe-3">Total (Kilos)</th>
                            <th class="py-2 text-center">Rollos</th>
                            <th class="py-2 text-center">Estatus</th>
                            <th class="py-2 text-start ps-3">Comentarios</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int contador = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center bg-light text-muted fw-bold">@contador</td>
                                    <td class="text-start ps-3">
                                        <i class="bi bi-calendar3 text-muted me-1 small"></i>
                                        @(item.DeliveryDate != null ? item.DeliveryDate.Value.ToString("dd/MM/yyyy") : "-")
                                    </td>
                                    <td class="fw-bold text-dark font-monospace ps-3">@item.LoteCode</td>
                                    <td class="text-dark ps-3">@item.PrintColoJumb</td>
                                    <td class="text-end fw-semibold font-monospace pe-3 text-success">@item.SumKl.ToString("N2")</td>
                                    <td class="text-center font-monospace">@item.SumRolls</td>
                                    <td class="text-center">
                                        @if (item.Status == "Entregado")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">@item.Status</span>
                                        }
                                        else if (!string.IsNullOrEmpty(item.Status) && (item.Status.Contains("No") || item.Status.Contains("malo")))
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">@item.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border px-2 py-1">@(string.IsNullOrEmpty(item.Status) ? "-" : item.Status)</span>
                                        }
                                    </td>
                                    <td class="text-muted small ps-3">@(string.IsNullOrEmpty(item.Comments) ? "-" : item.Comments)</td>
                                </tr>
                                contador++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5 bg-white">
                                    <i class="bi bi-file-excel display-5 text-success opacity-50"></i>
                                    <p class="mt-2 mb-0 fw-semibold">No hay registros disponibles en el sistema.</p>
                                    <p class="small text-muted">Sube tu archivo de Excel para poblar la vista de datos.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>